{
  "name": "@ai-ecoverse/gpu-ask.js",
  "version": "0.1.0",
  "description": "Agent questions in the browser: ONNX tagger + CRF + ask-tool compiler",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "models",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib",
    "dev": "vite demo",
    "build:demo": "vite build demo",
    "preview": "vite preview demo",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "onnxruntime-common": ">=1.30.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "onnxruntime-common": "1.30.0",
    "onnxruntime-web": "1.30.0",
    "tsx": "4.23.15",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "keywords": [
    "agent",
    "ask",
    "questions",
    "onnxruntime",
    "browser",
    "crf",
    "gpu-time",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/gpu-ask.js.git"
  },
  "homepage": "https://ai-ecoverse.github.io/gpu-ask.js/",
  "bugs": {
    "url": "https://github.com/ai-ecoverse/gpu-ask.js/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
